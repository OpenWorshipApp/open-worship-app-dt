  "ignore": [
    { "pattern": "^\\([^)]+\\)\\s?\\S", "reason": "a passage reference or an installed Bible's name, such as (KJV) John 3:16 on a verse chip or (ASV) English ASV in the Bible version menu: the person's own data" },
    { "pattern": "<[a-z]{2,3}(-[A-Z]{2})?>$", "reason": "a language heading in the Bible version menu, not a control" },
    { "pattern": "^#[0-9a-fA-F]{6}$", "reason": "a colour swatch in the colour picker: the colour itself, the picker is the text-color / background-color item" },
    { "pattern": "^app-", "reason": "a font an installed language brings, named by that language: one of the font box's choices (the font-family item)" },
    { "pattern": "^(.+?)\\(([A-Z][\\w' -]+)\\)\\S", "reason": "a names-lookup row: a person or place in the lookup's language with its KJV name, then its description -- data, the rows are the lookup-search item's results" },
    { "pattern": "^\\p{Nd}+ (Verse \\p{Nd}+|Double click to select verses|Click to reveal the bible notes of this verse)", "reason": "a verse button of the Bible Lookup panel's passage: one button per verse of the person's chosen passage (the panel's verse picking is the Reader's, in the bible-lookup-reader-tools exclusion)" },
    { "pattern": "^\\p{Nd}+ (Book|Chapter|Verse Start|Verse End): ", "reason": "the Bible Lookup panel's title editor, showing the person's passage (the Reader's, in the bible-lookup-reader-tools exclusion)" },
    { "pattern": "^Bible Reference \\S", "reason": "the Bible Lookup panel's reference box with the person's passage typed in it: the box is the bible-reference item" },
    { "pattern": "^[^\\p{Script=Latin}\\p{Script=Common}\\p{Script=Inherited}]+( |$)", "reason": "words in a script that is not Latin: a passage, a Bible's short name or a record shown in the person's language -- data" },
    { "pattern": "\\.(pdf|txt|docx?|pptx?|png|jpe?g|mp3|mp4|json|own|owb|md|xml|html?)\\b", "reason": "a file name in the Bible Lookup panel's Resources: the person's own files" },
    { "pattern": "[A-Za-z]:\\\\", "reason": "a folder row showing its path: the person's own folders" },
    { "pattern": "^[A-Z0-9]{3}\\.\\d+\\.\\*", "reason": "a chapter's filename pattern heading in Resources: data" },
    { "pattern": "^[A-Z0-9]{3}\\.\\d+\\.[a-z0-9]+", "reason": "a chapter's file in Resources read with its caption: the person's own files" },
    { "pattern": "^\\d+px", "reason": "the Font Size value beside the Bible Lookup panel's slider" },
    { "pattern": "^Font size \\d+$", "reason": "the toolbar's Font size box read with the size typed in it: the box is the font-size item" },
