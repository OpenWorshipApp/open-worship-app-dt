    { "pattern": "^\\d*(Genesis|Exodus|Leviticus|Numbers|Deuteronomy|Joshua|Judges|Ruth|[123] ?Samuel|[123] ?Kings|[123] ?Chronicles|Ezra|Nehemiah|Esther|Job|Psalms?|Proverbs|Ecclesiastes|Song of Solomon|Isaiah|Jeremiah|Lamentations|Ezekiel|Daniel|Hosea|Joel|Amos|Obadiah|Jonah|Micah|Nahum|Habakkuk|Zephaniah|Haggai|Zechariah|Malachi|Matthew|Mark|Luke|John|Acts|Romans|[123] ?Corinthians|Galatians|Ephesians|Philippians|Colossians|[123] ?Thessalonians|[123] ?Timothy|Titus|Philemon|Hebrews|James|[123] ?Peter|[123] ?John|Jude|Revelation)( .*)?$", "reason": "a book name of the installed Bible (book buttons, the book filter): the book buttons are one item (pick-book)" },
    { "pattern": "\\.(pdf|txt|docx?|pptx?|png|jpe?g|mp3|mp4|own|owb|md|xml|html?)\\b", "reason": "a file name in a list or in Resources: the person's own files" },
    { "pattern": "[A-Za-z]:\\\\", "reason": "a folder row showing its path: the person's own folders" },
    { "pattern": "^(zz-|ZZ )", "reason": "the test fixtures' list, note and preset names on this machine: data, not a control" },
    { "pattern": "^[\\u1780-\\u17FF\\u200b\\s]+$", "reason": "words of a Khmer passage (a name link in the text): data" },
    { "pattern": "^[\\u1780-\\u17FF]+ Khmer BFBS", "reason": "the Khmer Bible installed here, on its version chip: data" },
    { "pattern": "\\([0-9០-៩]+\\):", "reason": "a cross-reference row: a verse reference and its text, data (the rows are one item, open-verse-link)" },
    { "pattern": "^(.+?)([A-Za-z][\\w']* [\\w']+).* \\2", "reason": "a names-lookup record row: the record's name and its description, which the row repeats (the harvest cuts a label at 80 characters, so the repeat is matched on its first two words): data, the rows are one item (names-open-record)" },
    { "pattern": "^(Egypt|Mount Nebo|Moab|Jordan|Sinai|Jericho|Horeb|Bashan|Heshbon|Paran|Amram|Jochebed|Zipporah|Eliezer|Aaron|Miriam|Izhar|Jahaziel|Korah|Libni|Mahali|Nepheg|Uzziel|Elzaphan|Hebron|Jekameam|Jeriah|Jerijah|Mishael|Zichri|Zithri|Mahli|Mushi)( .*)?$", "reason": "rows of the record opened during the harvest (Moses): its relatives and places, data" },
    { "pattern": "^(Parents|Spouses|Children|Siblings|Cousins|Locations|Verses|Links)\\d+$", "reason": "a record's section with its count appended: the sections are the record-relations item" },
    { "pattern": "<[a-z]{2}(-[A-Z]{2})?>$", "reason": "a language heading in the version menu, not a control" },
    { "pattern": "^[A-Z0-9]{3}\\.\\d+\\.\\*", "reason": "a chapter's filename pattern heading in Resources: data" },
